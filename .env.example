# ==========================================================================
# Auto WP Publisher — Environment Variables
# --------------------------------------------------------------------------
# Copy this file to `.env` at the repository root and fill in real values.
# The server validates these at boot (see apps/server/src/shared/config).
# Never commit a real `.env` — it is git-ignored.
# ==========================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL) --------------------------------------------------
# Used by docker-compose to provision the local database container.
DB_USER=admin
DB_PASSWORD=admin_password
DB_NAME=wp_publisher_db
DB_PORT=5432
# Full connection string consumed by Prisma / the API.
DATABASE_URL="postgresql://admin:admin_password@localhost:5432/wp_publisher_db?schema=public"

# --- Redis / BullMQ ---------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Authentication ---------------------------------------------------------
# Must be at least 16 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- CORS -------------------------------------------------------------------
# "*" allows any origin (credentials disabled). For production, set a
# comma-separated allow-list, e.g. https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# --- Rate limiting ----------------------------------------------------------
# Window length in seconds and max requests per window (per client IP).
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# --- Integrations -----------------------------------------------------------
# Google Gemini AI — used for product description generation.
GEMINI_API_KEY=

# WordPress / WooCommerce target site.
WP_API_URL=
WP_USERNAME=
WP_APP_PASSWORD=
